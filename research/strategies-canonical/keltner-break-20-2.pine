//@version=6
strategy("Canon Keltner Break 20/2 L/F", overlay=true, initial_capital=100000, currency=currency.EGP, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.10, pyramiding=0, calc_on_order_fills=false, process_orders_on_close=false)
// Channel breakout: enter above upper Keltner (EMA20 + 2*ATR10), exit below EMA20.
basis = ta.ema(close, 20)
rng = 2.0 * ta.atr(10)
if close[1] > basis[1] + rng[1] and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if close[1] < basis[1] and strategy.position_size > 0
    strategy.close("L")
plot(basis, "EMA20")
