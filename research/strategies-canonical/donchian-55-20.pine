//@version=6
strategy("Canon Donchian 55/20 L/F", overlay=true, initial_capital=100000, currency=currency.EGP, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.10, pyramiding=0, calc_on_order_fills=false, process_orders_on_close=false)
// Turtle classic: 55-day breakout entry, 20-day low exit.
hi = ta.highest(high, 55)
lo = ta.lowest(low, 20)
if close[1] > hi[2] and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if close[1] < lo[2] and strategy.position_size > 0
    strategy.close("L")
plot(hi, "55d high")
plot(lo, "20d low")
